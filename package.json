{
  "name": "vibrations.cheminfo.org",
  "version": "0.0.0",
  "description": "Predict and explore infrared and Raman spectra of a molecule in the browser",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check-deploy": "node node_modules/react-cheminfo/bin/check-deploy.mjs --image-name=ghcr.io/cheminfo/vibrations.cheminfo.org",
    "check-tokens": "node node_modules/react-cheminfo/bin/check-tokens.mjs --fallbacks src",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "preview": "vite preview",
    "test": "npm run test-only && npm run check-types && npm run check-tokens && npm run check-deploy && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@blueprintjs/icons": "^6.13.0",
    "@blueprintjs/select": "^6.3.0",
    "@preact/signals-react": "^3.12.0",
    "ir-spectrum": "^4.2.1",
    "ml-distance": "^4.1.0",
    "ml-spectra-processing": "^14.35.1",
    "molstar": "^5.11.0",
    "openchemlib": "^9.25.0",
    "raman-spectrum": "^1.0.1",
    "react": "^19.2.8",
    "react-cheminfo": "^0.24.0",
    "react-dom": "^19.2.8",
    "react-mf": "^3.1.1",
    "react-ocl": "^8.7.2",
    "react-plot": "^3.1.2",
    "react-science": "^23.1.1",
    "spc-parser": "^2.1.1",
    "spectrum-generator": "^8.2.1",
    "xtb-wasm": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@zakodium/tsconfig": "^1.0.5",
    "cheminfo-types": "^1.16.0",
    "eslint": "^9",
    "eslint-config-zakodium": "^20.1.0",
    "prettier": "^3.9.6",
    "typescript": "^6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
